function! AIHelper()
  try
    let tmpfile = '/tmp/ai_input.txt'
    let codefile = '/tmp/ai_code.txt'
    let expfile = '/tmp/ai_explanation.txt'

    " Ask user for instruction
    let user_prompt = input('Instruction (e.g. fix, refactor, simplify): ')
    if user_prompt == ""
      echo "Cancelled."
      return
    endif

    let l:start = line("'<")
    let l:end   = line("'>")
    let filetype = &filetype

    " Write prompt and selection to tmp
    call writefile([user_prompt, ''], tmpfile)
    execute l:start . "," . l:end . "write >>" . tmpfile

    echo "AI is generating your response..."
    let $VIM_FILETYPE = filetype
    silent execute "!python3 ~/vim-ai-assistant/assistant.py < " . tmpfile

    " Save original buffer number
    let orig_buf = bufnr('%')

    " Create scratch buffer with AI code
    let temp_buf = bufnr('__AICode__')
    if temp_buf != -1
      execute 'bd! ' . temp_buf
    endif

    " Open AI code in a new vertical split
    execute 'vnew __AICode__'
    setlocal buftype=nofile bufhidden=wipe nobuflisted noswapfile
    silent execute '0read ' . codefile
    normal! gg

    wincmd p
    redraw
    echo "Preview ready. Press 'y' to accept changes, 'n' to cancel."
    let choice = nr2char(getchar())

    if choice ==# 'y'
      " Apply changes
      execute 'b ' . orig_buf
      execute l:start . "," . l:end . "delete _"
      call cursor(l:start, 1)
      execute "read " . codefile
      echo "Changes applied."

      " Clean preview
      if bufexists('__AICode__')
        execute 'bwipeout! __AICode__'
      endif
      if winnr('$') > 1
        execute 'only'
      endif

      " Show explanation *only after accept*
      execute 'vert new'
      setlocal buftype=nofile bufhidden=wipe noswapfile
      silent execute "0read " . expfile
      normal! gg

    else
      " Cancel, keep original
      if bufexists('__AICode__')
        execute 'bwipeout! __AICode__'
      endif
      if winnr('$') > 1
        execute 'only'
      endif
      echo "Change cancelled."
      return
    endif

  catch /.*/
    echohl ErrorMsg
    echom "AIHelper error: " . v:exception
    echohl None
  endtry
endfunction

" Map the function to \a in visual mode
vnoremap <leader>a :<C-U>call AIHelper()<CR>

